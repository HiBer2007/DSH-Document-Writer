{
  "name": "@local/dsh-docwrite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "文档工坊 for DSH Desktop: packaged docwrite tools, a hard stage gate, and a pipeline panel in the Web GUI.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "cli/**"
  ],
  "dependencies": {
    "fflate": "^0.8.2",
    "yaml": "^2.8.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-layout"]
    }
  }
}
